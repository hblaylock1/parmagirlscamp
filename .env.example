# Required
ADMIN_PASSWORD=change-me-admin-password
SESSION_SECRET=generate-a-long-random-string-here

# This site runs in single-ward mode (authMode "single" in lib/event.ts):
# admin login is password-only, so no WARD_PASSWORD_* variables are needed.
# If you switch to authMode "stake" with multiple wards, add one variable per
# ward named WARD_PASSWORD_<WARD_NAME_UPPERCASED_WITH_UNDERSCORES>, e.g.
#   WARD_PASSWORD_PARMA_1ST_WARD=
